---
import VisionLoop from './VisionLoop.astro';
// HTML version of the research-vision diagram (default; see `visionStyle` in taxonomy.yaml).
// Side panels come from src/data/taxonomy.yaml; the center loop and the cluster icons
// are extracted from design/vision.svg by scripts/build-vision.mjs.
import { taxonomy, md } from '../lib/data';
import centerSvg from '../generated/vision-center.svg?raw';
import icons from '../generated/vision-icons.json';

const link = (name: string) => {
  const target = taxonomy.svgLinks[name];
  if (!target) return { href: undefined, external: false, project: undefined };
  const external = /^https?:/.test(target);
  return { href: external ? target : `#p-${target}`, external, project: external ? undefined : target };
};
const iconMap: Record<string, string> = icons;
const isWin = (award: string) => !/honorable mention|nomination|finalist/i.test(award);
const trophy = '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M5 2h6v4a3 3 0 0 1-6 0V2ZM5 3.5H2.5V5A2.5 2.5 0 0 0 5 7.5M11 3.5h2.5V5A2.5 2.5 0 0 1 11 7.5M8 9v3M5.5 14h5M6.5 12h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>';
const ribbon = '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><circle cx="8" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M5.6 9.3 4.8 15 8 13.2 11.2 15l-.8-5.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>';
---
<div class="vp">
  {taxonomy.themes.map((th: any, i: number) => (
    <>
      <section class={`vp-panel vp-${th.axis}`} aria-label={th.label}>
        <button type="button" class="vp-head v-theme" data-theme={th.id} aria-pressed="false">{th.label}</button>
        <p class="vp-intro" set:html={md(th.intro)} />
        <ul class="vp-list">
          {th.clusters.map((c: any) => (
            <li>
              <div class="vp-item v-cluster" data-vision={c.id} data-theme={th.id} role="button" tabindex="0" aria-pressed="false" aria-label={`Show publications on ${c.label}`}>
                <button type="button" class="vp-clear" aria-label={`Clear the ${c.label} filter`} tabindex="-1">
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </button>
                {iconMap[c.id] && <span class="vp-icon" set:html={iconMap[c.id]} />}
                <div class="vp-text">
                  <p class="vp-title">{c.label}</p>
                  <p class="vp-desc">{c.description}</p>
                  <p class="vp-meta">
                    {c.items.map((it: string, k: number) => {
                      const [name, venue] = it.split('|');
                      const l = link(name);
                      return (
                        <>
                          {l.href ? (
                            <a href={l.href} class="v-link" data-project={l.project} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{name}</a>
                          ) : (
                            <span>{name}</span>
                          )}
                          {venue && <span class="vp-venue"> ({venue})</span>}
                          {k < c.items.length - 1 ? ', ' : ''}
                        </>
                      );
                    })}
                  </p>
                  {c.award && <p class="vp-award"><span set:html={isWin(c.award) ? trophy : ribbon} />{c.award}</p>}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
      {i === 0 && (
        <div class="vp-center">
          <div class="vp-center-art" set:html={centerSvg} />
          <VisionLoop />
        </div>
      )}
    </>
  ))}
</div>
